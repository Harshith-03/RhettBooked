# Secrets and env
.env
secrets/

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Node / frontend build
node_modules/
frontend/dist/

# Generated DuckDB (keep the committed deploy snapshot)
data/processed/*.duckdb
!deploy/eventtwin_demo.duckdb

# Cached external-API responses (regenerated at runtime)
data/raw/live/

# Large one-time Bluebikes trip download; only the small aggregated CSV is committed
data/raw/v3/bluebikes/raw/

# OpenAlex raw page cache; only the compact authors_topics.csv is committed
data/raw/live/openalex/

# NOTE: data/raw/bu/ and data/raw/v3..v5/ ARE committed on purpose - they are
# public datasets the Docker image needs at startup. Do not ignore them.
